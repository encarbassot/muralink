{
  "name": "@muralink/module-video-editor",
  "version": "0.1.0",
  "description": "video-editor — layered video/photo editing, synced as an op-log. Originals stay put; only edits sync.",
  "type": "module",
  "main": "./manifest.ts",
  "exports": {
    ".": "./manifest.ts",
    "./types": "./types.ts",
    "./web": "./implementations/web/index.ts",
    "./cell": "./cell.tsx",
    "./server": "./implementations/server/index.ts"
  },
  "files": [
    "manifest.ts",
    "types.ts",
    "cell.tsx",
    "implementations",
    "README.md"
  ],
  "dependencies": {
    "@muralink/realtime": "*",
    "@muralink/shell": "^0.1.0",
    "@muralink/types": "^0.1.0",
    "@muralink/ui": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "express": ">=4",
    "better-sqlite3": ">=9"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "better-sqlite3": { "optional": true }
  },
  "license": "MIT"
}
