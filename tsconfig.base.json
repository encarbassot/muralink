{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@muralink/types": ["./packages/types/src/index.ts"],
      "@muralink/app": ["./packages/app/src/index.ts"],
      "@muralink/core": ["./packages/core/src/index.ts"],
      "@muralink/ui": ["./packages/ui/src/index.ts"],
      "@muralink/editor": ["./packages/editor/src/index.ts"],
      "@muralink/shell": ["./packages/shell/src/index.ts"],
      "@muralink/omnibar": ["./packages/omnibar/src/index.ts"],
      "@muralink/spaces": ["./packages/spaces/src/index.ts"],
      "@muralink/calc": ["./packages/calc/src/index.ts"],
      "@muralink/calc/blocks": ["./packages/calc/src/blocks/index.ts"],
      "@muralink/calc/sandbox": ["./packages/calc/src/sandbox/index.ts"],
      "@muralink/payments": ["./packages/payments/src/index.ts"],
      "@muralink/ai": ["./packages/ai/src/index.ts"],
      "@muralink/embed": ["./packages/embed/src/index.ts"],
      "@muralink/multiuser": ["./packages/multiuser/src/index.ts"],
      "@muralink/platform-server": ["./platforms/server/src/index.ts"],
      "@muralink/platform-server/entitlement": ["./platforms/server/src/entitlement/index.ts"],
      "@instance/*": ["./instances/default/*"]
    },
    "baseUrl": "."
  }
}
